/* ==========================================
   RESPONSIVE.CSS
   BAGIAN 1
========================================== */

/* ==========================================
   LAPTOP BESAR
   ≤ 1200px
========================================== */

@media (max-width:1200px){

    /* Container */

    .container{
        width:min(100% - 2rem,1100px);
    }

    /* Section */

    section{
        padding:90px 0;
    }

    /* Hero */

    .hero{
        min-height:85vh;
    }

    .hero-container{
        gap:3rem;
    }

    .hero-title{
        font-size:3rem;
    }

    .hero-description{
        font-size:1rem;
        max-width:550px;
    }

    .hero-image img{
        max-width:500px;
    }

    /* About */

    .about-container{
        gap:3rem;
    }

    .about-image img{
        max-width:450px;
    }

    /* Menu */

    .menu-grid{
        grid-template-columns:repeat(3,1fr);
        gap:1.75rem;
    }

    /* Gallery */

    .gallery-grid{
        grid-template-columns:repeat(3,1fr);
        gap:1rem;
    }

    /* Testimonial */

    .testimonial-grid{
        grid-template-columns:repeat(2,1fr);
    }

    /* Footer */

    .footer-grid{
        grid-template-columns:repeat(3,1fr);
    }

}

/* ==========================================
   LAPTOP
   ≤ 992px
========================================== */

@media (max-width:992px){

    /* Container */

    .container{
        width:min(100% - 1.5rem,960px);
    }

    /* Section */

    section{
        padding:80px 0;
    }

    /* Header */

    .header{
        padding:.9rem 0;
    }

    /* Hero */

    .hero-container{
        grid-template-columns:1fr 1fr;
        gap:2rem;
    }

    .hero-title{
        font-size:2.5rem;
    }

    .hero-description{
        font-size:.95rem;
    }

    .hero-image img{
        max-width:420px;
    }

    /* About */

    .about-container{
        grid-template-columns:1fr 1fr;
        gap:2rem;
    }

    .about-image img{
        max-width:400px;
    }

    /* Menu */

    .menu-grid{
        grid-template-columns:repeat(2,1fr);
    }

    /* Gallery */

    .gallery-grid{
        grid-template-columns:repeat(3,1fr);
    }

    /* Contact */

    .contact-container{
        grid-template-columns:1fr 1fr;
    }

    /* Order */

    .order-container{
        grid-template-columns:1fr;
        gap:2rem;
    }

    /* Footer */

    .footer-grid{
        grid-template-columns:repeat(2,1fr);
        gap:2rem;
    }

}

/* ==========================================
   RESPONSIVE.CSS
   BAGIAN 2
   TABLET
========================================== */

@media (max-width:768px){

    /* ==========================
       Container
    ========================== */

    .container{

        width:min(100% - 1.5rem,720px);

    }

    section{

        padding:70px 0;

    }

    /* ==========================
       Header
    ========================== */

    .header{

        padding:14px 0;

    }

    /* ==========================
       Navbar
    ========================== */

    .navbar{

        position:fixed;

        top:0;

        right:-100%;

        width:280px;

        height:100vh;

        background:#fff;

        display:flex;

        flex-direction:column;

        justify-content:flex-start;

        align-items:flex-start;

        padding:100px 30px;

        gap:20px;

        transition:.35s ease;

        z-index:999;

        overflow-y:auto;

    }

    .navbar.active{

        right:0;

    }

    .burger{

        display:flex;

    }

    .menu-overlay{

        position:fixed;

        inset:0;

        background:rgba(0,0,0,.45);

        opacity:0;

        visibility:hidden;

        transition:.3s;

        z-index:998;

    }

    .menu-overlay.show{

        opacity:1;

        visibility:visible;

    }

    /* ==========================
       Hero
    ========================== */

    .hero{

        min-height:auto;

        padding-top:120px;

    }

    .hero-container{

        grid-template-columns:1fr;

        text-align:center;

        gap:40px;

    }

    .hero-content{

        order:2;

    }

    .hero-image{

        order:1;

    }

    .hero-image img{

        width:100%;

        max-width:420px;

    }

    .hero-buttons{

        justify-content:center;

        flex-wrap:wrap;

    }

    /* ==========================
       About
    ========================== */

    .about-container{

        grid-template-columns:1fr;

        gap:40px;

        text-align:center;

    }

    .about-image img{

        max-width:420px;

        margin:auto;

    }

    /* ==========================
       Menu
    ========================== */

    .menu-grid{

        grid-template-columns:1fr;

    }

    /* ==========================
       Gallery
    ========================== */

    .gallery-grid{

        grid-template-columns:repeat(2,1fr);

    }

    /* ==========================
       Testimonial
    ========================== */

    .testimonial-grid{

        grid-template-columns:1fr;

    }

    /* ==========================
       FAQ
    ========================== */

    .faq-container{

        width:100%;

    }

    /* ==========================
       Contact
    ========================== */

    .contact-container{

        grid-template-columns:1fr;

    }

    /* ==========================
       Order
    ========================== */

    .order-container{

        grid-template-columns:1fr;

    }

    .order-summary{

        margin-top:30px;

    }

    /* ==========================
       Footer
    ========================== */

    .footer-grid{

        grid-template-columns:1fr;

        text-align:center;

    }

    .footer-social{

        justify-content:center;

    }

}

/* ==========================================
   RESPONSIVE.CSS
   BAGIAN 3
   MOBILE
========================================== */

@media (max-width:576px){

    /* ==========================
       Container
    ========================== */

    .container{

        width:min(100% - 1rem,540px);

    }

    section{

        padding:60px 0;

    }

    /* ==========================
       Header
    ========================== */

    .header{

        padding:12px 0;

    }

    .logo img{

        width:60px;

        height:auto;

    }

    /* ==========================
       Hero
    ========================== */

    .hero{

        padding-top:100px;

    }

    .hero-title{

        font-size:2.2rem;

        line-height:1.2;

    }

    .hero-description{

        font-size:.95rem;

    }

    .hero-buttons{

        display:flex;

        flex-direction:column;

        gap:1rem;

        width:100%;

    }

    .hero-buttons .btn{

        width:100%;

    }

    .hero-image img{

        width:100%;

        max-width:340px;

        margin:auto;

    }

    /* ==========================
       About
    ========================== */

    .about-image img{

        max-width:320px;

    }

    /* ==========================
       Menu
    ========================== */

    .menu-card{

        padding:1.25rem;

    }

    .menu-card img{

        width:100%;

        height:auto;

    }

    /* ==========================
       Gallery
    ========================== */

    .gallery-grid{

        grid-template-columns:repeat(2,1fr);

        gap:.75rem;

    }

    /* ==========================
       Testimonial
    ========================== */

    .testimonial-card{

        padding:1.25rem;

    }

    /* ==========================
       FAQ
    ========================== */

    .faq-item{

        padding:1rem;

    }

    /* ==========================
       Maps
    ========================== */

    .maps iframe{

        height:300px;

    }

    /* ==========================
       Contact
    ========================== */

    .contact-info,
    .contact-form{

        width:100%;

    }

    /* ==========================
       Order
    ========================== */

    .order-item{

        flex-direction:column;

        align-items:flex-start;

        gap:1rem;

    }

    .qty-control{

        width:100%;

        justify-content:space-between;

    }

    .summary-item{

        flex-direction:column;

        align-items:flex-start;

        gap:.5rem;

    }

    .payment-method{

        display:grid;

        gap:.75rem;

    }

    /* ==========================
       Footer
    ========================== */

    .footer{

        text-align:center;

    }

    .footer-social{

        justify-content:center;

        flex-wrap:wrap;

    }

}