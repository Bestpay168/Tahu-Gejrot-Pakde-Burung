/* ==========================================
   GOOGLE MAPS RESPONSIVE
========================================== */

@media (max-width:992px){

    .map-box{

        height:420px;

    }

}

@media (max-width:768px){

    .maps{

        padding:80px 0;

    }

    .map-box{

        height:350px;
        border-radius:15px;

    }

}

@media (max-width:480px){

    .map-box{

        height:300px;

    }

}